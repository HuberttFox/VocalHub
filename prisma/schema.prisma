generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
  SOURCE_MISSING
  SOURCE_DELETED
}

enum SyncRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum SyncRunMode {
  IDS
  SEED
  INCREMENTAL
  RECONCILE
  REFRESH
}

enum SyncEntity {
  SONG
  ARTIST
}

enum PlaylistVisibility {
  PRIVATE
  PUBLIC
}

enum PlaylistCollaboratorRole {
  EDITOR
}

model Song {
  id                  String             @id @default(uuid()) @db.Uuid
  vocadbId            Int                @unique
  name                String
  defaultName         String
  defaultNameLanguage String
  artistString        String
  songType            String
  sourceStatus        String
  sourceDeleted       Boolean            @default(false)
  sourceCreatedAt     DateTime
  publishDate         DateTime?
  durationSeconds     Int
  favoritedTimes      Int
  ratingScore         Int
  originalVersionId   Int?
  cultureCodes        String[]
  coverUrlOriginal    String?
  coverUrlThumb       String?
  sourceVersion       Int
  sourceUpdatedAt     DateTime?
  lastSyncedAt        DateTime?
  syncStatus          SyncStatus         @default(PENDING)
  lastSyncError       String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  names               SongName[]
  artistCredits       SongArtistCredit[]
  tags                SongTag[]
  pvs                 SongPV[]
  favorites           Favorite[]
  playlistSongs       PlaylistSong[]

  @@index([publishDate])
  @@index([sourceStatus])
  @@index([syncStatus])
}

model SongName {
  id       String @id @default(uuid()) @db.Uuid
  songId   String @db.Uuid
  language String
  value    String
  position Int
  song     Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([songId, position])
}

model Artist {
  id                     String             @id @default(uuid()) @db.Uuid
  vocadbId               Int                @unique
  name                   String
  defaultName            String
  defaultNameLanguage    String
  additionalNames        String[]
  description            String?
  artistType             String
  sourceStatus           String
  sourceVersion          Int
  sourceDeleted          Boolean            @default(false)
  sourceCreatedAt        DateTime?
  releaseDate            DateTime?
  sourceUpdatedAt        DateTime?
  mergedToVocaDbId       Int?
  pictureMime            String?
  pictureUrlOriginal     String?
  pictureUrlThumb        String?
  pictureUrlSmallThumb   String?
  pictureUrlTinyThumb    String?
  detailLastAttemptAt    DateTime?
  detailLastSyncedAt     DateTime?
  lastSyncedAt           DateTime?
  syncStatus             SyncStatus         @default(PENDING)
  lastSyncError          String?
  summaryName            String
  summaryArtistType      String
  summaryAdditionalNames String[]
  summarySourceStatus    String
  summarySourceVersion   Int
  summarySourceDeleted   Boolean            @default(false)
  summaryObservedAt      DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  names                  ArtistName[]
  webLinks               ArtistWebLink[]
  songCredits            SongArtistCredit[]

  @@index([detailLastSyncedAt])
  @@index([syncStatus])
}

model ArtistName {
  id       String @id @default(uuid()) @db.Uuid
  artistId String @db.Uuid
  language String
  value    String
  position Int
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, position])
}

model ArtistWebLink {
  id          String  @id @default(uuid()) @db.Uuid
  artistId    String  @db.Uuid
  vocadbId    Int
  url         String
  description String
  category    String
  disabled    Boolean @default(false)
  position    Int
  artist      Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, vocadbId])
  @@index([artistId, position])
}

model SongArtistCredit {
  id             String   @id @default(uuid()) @db.Uuid
  vocadbId       Int
  songId         String   @db.Uuid
  artistId       String?  @db.Uuid
  name           String
  categories     String[]
  roles          String[]
  effectiveRoles String[]
  isSupport      Boolean
  isCustomName   Boolean
  position       Int
  song           Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  artist         Artist?  @relation(fields: [artistId], references: [id], onDelete: SetNull)

  @@unique([songId, vocadbId])
  @@index([songId, position])
}

model Tag {
  id              String    @id @default(uuid()) @db.Uuid
  vocadbId        Int       @unique
  name            String
  additionalNames String[]
  categoryName    String?
  urlSlug         String?
  lastSyncedAt    DateTime?
  songs           SongTag[]
}

model SongTag {
  songId   String @db.Uuid
  tagId    String @db.Uuid
  count    Int
  position Int
  song     Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([songId, tagId])
  @@index([songId, position])
  @@index([tagId, songId])
}

model SongPV {
  id              String    @id @default(uuid()) @db.Uuid
  vocadbId        Int
  songId          String    @db.Uuid
  externalId      String
  service         String
  pvType          String
  url             String
  name            String?
  author          String?
  thumbnailUrl    String?
  publishDate     DateTime?
  durationSeconds Int?
  disabled        Boolean   @default(false)
  position        Int
  lastSyncedAt    DateTime?
  song            Song      @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([songId, vocadbId])
  @@index([songId, position])
}

model User {
  id            String     @id @default(uuid()) @db.Uuid
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt
  accounts      Account[]
  sessions      Session[]
  favorites     Favorite[]
  playlists     Playlist[]
  collaborations PlaylistCollaborator[]
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Favorite {
  userId    String   @db.Uuid
  songId    String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([userId, songId])
  @@index([userId, createdAt, songId])
  @@index([songId])
}

model Playlist {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  name        String
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  visibility  PlaylistVisibility @default(PRIVATE)
  shareToken  String?        @unique
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  songs       PlaylistSong[]
  collaborators PlaylistCollaborator[]

  @@index([userId, updatedAt, id])
  @@index([visibility])
}

model PlaylistCollaborator {
  playlistId String                    @db.Uuid
  userId     String                    @db.Uuid
  role       PlaylistCollaboratorRole  @default(EDITOR)
  createdAt  DateTime                  @default(now())
  playlist   Playlist                  @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  user       User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([playlistId, userId])
  @@index([userId, playlistId])
}

model PlaylistSong {
  playlistId String   @db.Uuid
  songId     String   @db.Uuid
  position   Int
  addedAt    DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([playlistId, songId])
  @@unique([playlistId, position])
  @@index([songId])
}

model SyncRun {
  id                   String        @id @default(uuid()) @db.Uuid
  sequence             BigInt        @unique @default(autoincrement())
  entity               SyncEntity    @default(SONG)
  mode                 SyncRunMode   @default(IDS)
  status               SyncRunStatus @default(RUNNING)
  startedAt            DateTime      @default(now())
  discoveryCompletedAt DateTime?
  finishedAt           DateTime?
  activityWindowStart  DateTime?
  activityWindowEnd    DateTime?
  baselineAt           DateTime?
  refreshCutoffAt      DateTime?
  expectedStateVersion Int?
  sourceIdCount        Int?
  sourceIdDigest       String?
  requestedCount       Int           @default(0)
  successCount         Int           @default(0)
  failureCount         Int           @default(0)
  errorCode            String?
  errorMessage         String?
  items                SyncItem[]

  @@index([entity, status, sequence])
}

model SyncItem {
  id            String     @id @default(uuid()) @db.Uuid
  runId         String     @db.Uuid
  vocadbId      Int
  status        SyncStatus @default(PENDING)
  sourcePresent Boolean?
  attemptCount  Int        @default(0)
  errorCode     String?
  errorMessage  String?
  startedAt     DateTime?
  lastAttemptAt DateTime?
  finishedAt    DateTime?
  run           SyncRun    @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, vocadbId])
}

model VocaDbSongSyncState {
  id                  String    @id
  version             Int       @default(0)
  activityCheckpoint  DateTime?
  lastSeedCompletedAt DateTime?
  lastReconciledAt    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}
