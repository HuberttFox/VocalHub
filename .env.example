DATABASE_URL="postgresql://vocalhub:vocalhub@localhost:5432/vocalhub"
DIRECT_URL="postgresql://vocalhub:vocalhub@localhost:5432/vocalhub"
TEST_DATABASE_URL="postgresql://vocalhub:vocalhub@localhost:5433/vocalhub_test"
BENCHMARK_DATABASE_URL="postgresql://vocalhub:vocalhub@localhost:5434/vocalhub_benchmark"

AUTH_SECRET="replace-with-a-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_GITHUB_ID="replace-with-github-oauth-client-id"
AUTH_GITHUB_SECRET="replace-with-github-oauth-client-secret"

# Required only by compose.production.yaml; use immutable registry digests.
VOCALHUB_APP_IMAGE="registry.example/vocalhub-app@sha256:replace-with-digest"
VOCALHUB_MIGRATE_IMAGE="registry.example/vocalhub-migrate@sha256:replace-with-digest"
# Must be a real random value of at least 16 characters; the placeholder here
# is rejected by /api/ops/status so the endpoint fails closed.
OPERATIONAL_STATUS_TOKEN="replace-with-a-random-operations-token"
# Enable only after discovery snapshot migration, backfill, and parity checks.
DISCOVERY_SNAPSHOT_READS_ENABLED="false"
# Per-profile snapshot build cap; must remain within generic 30-minute maintenance deadline.
DISCOVERY_MATERIALIZER_BUILD_TIMEOUT_MS="300000"

VOCADB_BASE_URL="https://vocadb.net/api/"
VOCADB_USER_AGENT="VocalHub/0.1 (+https://github.com/HuberttFox/VocalHub)"
VOCADB_TIMEOUT_MS="10000"
VOCADB_ACTIVITY_OVERLAP_MS="900000"
VOCADB_SETTLEMENT_LAG_MS="120000"
VOCADB_ARTIST_REFRESH_INTERVAL_MS="604800000"
VOCADB_SYNC_CONCURRENCY="2"
