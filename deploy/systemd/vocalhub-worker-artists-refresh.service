[Unit]
Description=Run VocalHub artist refresh
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/vocalhub/current
EnvironmentFile=/etc/vocalhub/vocalhub.env
ExecStart=/usr/bin/docker compose -f /opt/vocalhub/current/compose.production.jobs.yaml --profile worker run --rm --no-deps worker artists auto refresh
TimeoutStartSec=2h
StandardOutput=journal
StandardError=journal
