# Install this edited file as /etc/vocalhub/vocalhub.env with mode 0600.
# Keep it outside the release checkout. Units use /opt/vocalhub/current and
# /opt/vocalhub/current/compose.production.jobs.yaml; update unit paths as
# part of release installation and do not use a mutable checkout.
# Docker Compose reads DATABASE_URL, worker/maintenance image variables, and
# VocaDB variables from this file. Do not add app, migration, or AUTH_* variables:
# systemd units only invoke compose.production.jobs.yaml.
DATABASE_URL=postgresql://user:password@db.example/vocalhub
VOCALHUB_WORKER_IMAGE=registry.example/vocalhub-worker@sha256:replace-with-digest
VOCALHUB_MAINTENANCE_IMAGE=registry.example/vocalhub-maintenance@sha256:replace-with-digest
VOCADB_BASE_URL=https://vocadb.net/api/
VOCADB_USER_AGENT=replace-with-operator-contact
VOCADB_TIMEOUT_MS=10000
VOCADB_ACTIVITY_OVERLAP_MS=900000
VOCADB_SETTLEMENT_LAG_MS=120000
VOCADB_ARTIST_REFRESH_INTERVAL_MS=604800000
VOCADB_SYNC_CONCURRENCY=2
